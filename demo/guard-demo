#!/bin/bash
# Demo for the README GIF: feeds commands to deny-guard (nothing is executed),
# then renders the status line with sample session data. Run: bash demo/guard-demo
D="$(cd "$(dirname "$0")/.." && pwd)"

try() {
  printf '\033[2m$\033[0m %s\n' "$1"
  r=$(jq -n --arg c "$1" '{tool_input:{command:$c}}' | bash "$D/hooks/deny-guard.sh" | jq -r '.hookSpecificOutput.permissionDecisionReason // empty')
  if [ -n "$r" ]; then printf '  \033[31m✗ blocked:\033[0m %s\n\n' "$r"; else printf '  \033[32m✓ allowed\033[0m\n\n'; fi
  sleep 1.2
}

printf '\033[1mCommands Claude tries to run, checked by deny-guard:\033[0m\n\n'
try "git status"
try "r''m -rf ~/project"
try "for f in src/*; do rm \$f; done"
try "echo cm0gLXJmIH4= | base64 -d"
try "cat ~/.ssh/id_ed25519"
try "npm run build"

printf '\033[1mStatus line:\033[0m\n'
jq -n --arg d "$D" '{model:{display_name:"Opus"},context_window:{used_percentage:42},cost:{total_cost_usd:1.5},rate_limits:{five_hour:{used_percentage:12},seven_day:{used_percentage:30}},workspace:{current_dir:$d}}' \
  | bash "$D/hooks/statusline.sh"
